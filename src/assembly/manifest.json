{
  "areas": ["eksterior", "interior", "atap", "props"],
  "components": {
    "lantai": { "src": "eksterior/lantai.glb" },
    "tiang": { "src": "eksterior/tiang.glb" },
    "dinding_luar": { "src": "eksterior/dinding_luar.glb" },
    "pagar": { "src": "eksterior/pagar.glb" },
    "tiang_usei": { "src": "eksterior/tiang_usei.glb" },
    "tangga": { "src": "eksterior/tangga.glb" },
    "dinding_dalam": { "src": "interior/dinding_dalam.glb" },
    "tiang_dalam": { "src": "interior/tiang_dalam.glb" },
    "rangka": { "src": "interior/rangka.glb" },
    "atap": { "src": "atap/atap.glb", "placeholder": true },
    "atap_atang": { "src": "atap/atap_atang.glb", "placeholder": true },
    "atap_usei_sisi": { "src": "atap/atap_usei_sisi.glb", "placeholder": true },
    "atap_usei_tengah": { "src": "atap/atap_usei_tengah.glb", "placeholder": true },
    "tanah": { "src": "props/tanah.glb" }
  },
  "instances": [
    { "id": "tanah", "component": "tanah" },
    { "id": "lantai", "component": "lantai", "attach": { "anchor": "anchor_base", "to": "tanah.anchor_house" } },
    { "id": "tiang", "component": "tiang", "attach": { "anchor": "anchor_top", "to": "lantai.anchor_tiang_*" } },
    { "id": "dinding_luar", "component": "dinding_luar", "attach": { "anchor": "anchor_base", "to": "lantai.anchor_dinding" } },
    { "id": "dinding_dalam", "component": "dinding_dalam", "attach": { "anchor": "anchor_base", "to": "lantai.anchor_dinding" } },
    { "id": "tiang_dalam", "component": "tiang_dalam", "attach": { "anchor": "anchor_base", "to": "lantai.anchor_interior" } },
    { "id": "rangka", "component": "rangka", "attach": { "anchor": "anchor_base", "to": "dinding_luar.anchor_rangka" } },
    { "id": "pagar", "component": "pagar", "attach": { "anchor": "anchor_base", "to": "lantai.anchor_pagar" } },
    { "id": "tiang_usei", "component": "tiang_usei", "attach": { "anchor": "anchor_base", "to": "lantai.anchor_pagar" } },
    { "id": "tangga_kiri", "component": "tangga", "attach": { "anchor": "anchor_top", "to": "lantai.anchor_tangga_kiri" } },
    { "id": "tangga_kanan", "component": "tangga", "attach": { "anchor": "anchor_top", "to": "lantai.anchor_tangga_kanan" } },
    { "id": "atap", "component": "atap", "attach": { "anchor": "anchor_base", "to": "rangka.anchor_atap" } },
    { "id": "atap_atang", "component": "atap_atang", "attach": { "anchor": "anchor_base", "to": "rangka.anchor_atap_atang" } },
    { "id": "atap_usei_kiri", "component": "atap_usei_sisi", "attach": { "anchor": "anchor_base", "to": "rangka.anchor_atap_usei_kiri" } },
    { "id": "atap_usei_tengah", "component": "atap_usei_tengah", "attach": { "anchor": "anchor_base", "to": "rangka.anchor_atap_usei_tengah" } },
    { "id": "atap_usei_kanan", "component": "atap_usei_sisi", "attach": { "anchor": "anchor_base", "to": "rangka.anchor_atap_usei_kanan" } }
  ],
  "allowOverlap": [
    ["atap*", "atap*"],
    ["atap*", "rangka"],
    ["tangga_*", "tanah"],
    ["tangga_*", "lantai"],
    ["tangga_*", "pagar"]
  ]
}
